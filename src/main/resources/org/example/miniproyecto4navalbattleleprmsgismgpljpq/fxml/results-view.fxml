<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<!-- results-view.fxml -->
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.miniproyecto4navalbattleleprmsgismgpljpq.controller.ResultsController"
      alignment="CENTER" spacing="15">
    <Label fx:id="outcomeLabel" styleClass="game-title"/>
    <Label fx:id="statsLabel"/>
    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="playAgainButton" text="Jugar de nuevo" onAction="#handlePlayAgain"/>
        <Button fx:id="titleButton" text="Volver al inicio" onAction="#handleBackToTitle"/>
    </HBox>
</VBox>
