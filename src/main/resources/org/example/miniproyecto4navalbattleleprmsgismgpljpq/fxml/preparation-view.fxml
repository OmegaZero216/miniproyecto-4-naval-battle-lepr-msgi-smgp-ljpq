<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<!-- preparation-view.fxml -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.miniproyecto4navalbattleleprmsgismgpljpq.controller.PreparationController
">
    <center>
        <GridPane fx:id="placementGrid"/>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="rotateButton" text="Rotar (R)"/>
            <Button fx:id="confirmButton" text="Confirmar (Enter)" onAction="#handleConfirm"/>
        </HBox>
    </bottom>
</BorderPane>
